import math
import random
import sys
import functools

print = functools.partial(print, flush=True)

def get_floats(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return float(input())
        except ValueError:
            print("Invalid Input. Please type a number (e.g. 3, 5).")
        except EOFError:
            print("\n No input received. Exiting Program")
            raise SystemExit

def get_int(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flush()
            return int(input())
        except ValueError:
            print("Invalid Input. Please type a number (e.g. 3, 5).")
        except EOFError:
            print("\n No input received. Exiting Program")
            raise SystemExit

def safe_input(prompt):
    try:
        print(prompt, end=" ", flush=True)
        sys.stdout.flush()
        return input()
    except EOFError:
        print("\n No input received. Exiting Program")
        raise SystemExit

def pause():
    safe_input("\nPress ENTER to return to the menu...")

def print_header(title):
    print("\n" + "=" * 70)
    print(f"{title}")
    print("+" * 70)

# Section 1
def trig_menu():
    while True:
        print_header("TRIGONOMETRIC (CIRCULAR) FUNCTIONS")
        print("""
            1. Show the value of PI
            2. Convert degrees -> radians
            3. Convert radians -> degrees
            4. Compute sin, cos, tan of an angle
            5. Compute asin, acos, atan of a value (-1 to 1 for asin/acos)
            6. Back to Main Menu"""
        )
        
        choice = safe_input("Enter your choice: ").strip()

        if choice == "1":
            print(f"\nmath.pi = {math.pi}")
        elif choice == "2":
            deg = get_floats("Enter an angle in degrees: ")
            rad = math.radians(deg)
            print(f"\n{deg} degrees = {rad} radians")
        elif choice == "3":
            rad = get_floats("Enter an angle in radians: ")
            deg = math.degrees(rad)
            print(f"\n{rad} radians = {deg} degrees")
        elif choice == "4":
            deg = get_floats("Enter an angle in degrees: ")
            rad = math.radians(deg)
            print(f"\nAngle = {deg} degrees ({rad:.4f} radians)")
            print(f"sin({deg}) = {math.sin(rad):.4f}")
            print(f"cos({deg}) = {math.cos(rad):.4f}")
            if math.isclose(math.cos(rad), 0.0, abs_tol=1e-9):
                print(f"tan({deg}) = undefined (cos({deg}) is 0)")
            else:
                print(f"tan({deg}) = {math.tan(rad):.4f}")
        elif choice == "5":
            val = get_floats("Enter a value: ")
            print()
            try:
                asin_val = math.asin(val)
                print(f"asin({val}) = {asin_val:.6f} radians ({math.degrees(asin_val):.4f} degrees)")
            except ValueError:
                print("asin(x) requires -1 <= x <= 1. Skipped.")
            try:
                acos_val = math.acos(val)
                print(f"acos({val}) = {acos_val:.6f} radians ({math.degrees(acos_val):.4f} degrees)")
            except ValueError:
                print("acos(x) requires -1 <= x <= 1. Skipped.")
            try:
                atan_val = math.atan(val)
                print(f"atan({val}) = {atan_val:.6f} radians ({math.degrees(atan_val):.4f} degrees)")
            except ValueError:
                print("atan(x) calculation error. Skipped.")
        elif choice in ("6", "0"):
            return
        else:
            print("\nInvalid choice.")
        pause()

# Section 2
def hyperbolic_menu():
    while True:
        print_header("HYPERBOLIC FUNCTIONS")
        print("""
            1. Compute sinh, cosh, tanh of a value
            2. Compute asinh, acosh, atanh of a value
            3. Demonstrate hyperbolic identity (cosh^2(x) - sinh^2(x) = 1)
            6. Back to Main Menu"""
        )
        
        choice = safe_input("Enter your choice: ").strip()
        
        if choice == "1":
            x = get_floats("Enter a value for x: ")
            try:
                print(f"\nx = {x}")
                print(f"sinh({x}) = {math.sinh(x):.4f}")
                print(f"cosh({x}) = {math.cosh(x):.4f}")
                print(f"tanh({x}) = {math.tanh(x):.4f}")
            except OverflowError:
                print("Result too large to compute (overflow).")
        elif choice == "2":
            x = get_floats("Enter a value for x: ")
            print()
            try:
                print(f"asinh({x}) = {math.asinh(x):.6f}")
            except (ValueError, OverflowError) as e:
                print(f"asinh({x}) error: {e}")
            try:
                print(f"acosh({x}) = {math.acosh(x):.6f}")
            except ValueError:
                print("acosh(x) requires x >= 1. Skipped.")
            try:
                print(f"atanh({x}) = {math.atanh(x):.6f}")
            except ValueError:
                print("atanh(x) requires -1 < x < 1. Skipped.")
        elif choice == "3":
            x = get_floats("Enter a value for x: ")
            try:
                c = math.cosh(x)
                s = math.sinh(x)
                diff = (c ** 2) - (s ** 2)
                print(f"\ncosh({x})^2 = {c**2:.6f}")
                print(f"sinh({x})^2 = {s**2:.6f}")
                print(f"cosh^2({x}) - sinh^2({x}) = {diff:.6f} (approximately 1.0)")
            except OverflowError:
                print("Result too large to compute (overflow).")
        elif choice in ("6", "0", "4"):
            return
        else:
            print("\nInvalid choice.")
        pause()

# Section 3
def exponential_menu():
    while True:
        print_header("EXPONENTIAL & LOGARITHMS FUNCTIONS")
        print("""
            1. Show the value of e
            2. Compute exp(x)
            3. Compute the natural log, log10, and log2 of a value
            4. Compute log(x, base) with a custom base
            5. Compute pow(x, y) - built-in vs math.pow
            0. Back to Main Menu"""
        )
        
        choice = safe_input("Enter your choice: ").strip()
        
        if choice == "1":
            print(f"\nmath.e = {math.e}")
        elif choice == "2":
            x = get_floats("Enter a value for x: ")
            try:
                print(f"\nexp({x}) = e^{x} = {math.exp(x)}")
            except OverflowError:
                print("Result too large (overflow).")
        elif choice == "3":
            x = get_floats("Enter a value for x > 0: ")
            try:
                print(f"\nlog({x})   = {math.log(x)}")
                print(f"log10({x}) = {math.log10(x)}")
                print(f"log2({x})  = {math.log2(x)}")
            except ValueError:
                print("Logarithms require x > 0. Please try again.")
        elif choice == "4":
            x = get_floats("Enter x (must be > 0): ")
            b = get_floats("Enter the base b (must be > 0 and != 1): ")
            try:
                print(f"\nlog({x}, base={b}) = {math.log(x, b)}")
            except (ValueError, ZeroDivisionError):
                print("Invalid input for a logarithm with that base.")
        elif choice == "5":
            x = get_floats("Enter the base x: ")
            y = get_floats("Enter the exponent y: ")
            try:
                print(f"\nBuilt-in pow({x}, {y}) = {pow(x, y)}")
                print(f"math.pow({x}, {y}) = {math.pow(x, y)}")
                print("(Note: pow() can return an int for integer inputs; math.pow() always returns a float.)")
            except (ValueError, OverflowError) as e:
                print(f"Calculation error: {e}")
        elif choice == "0":
            return
        else:
            print("\nInvalid choice.")
        pause()

